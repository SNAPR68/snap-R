# ==========================================
# SnapR Environment Variables
# ==========================================
# Copy this file to .env.local and fill in your values.
# Required vars are marked [REQUIRED]; others are optional.

# ------------------------------------------
# Supabase
# ------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co    # [REQUIRED]
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key                  # [REQUIRED]
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key               # [REQUIRED] Server-side only — never expose
SUPABASE_JWT_SECRET=your-jwt-secret                          # [REQUIRED] Cloudflare Worker JWT verification (Settings > API)

# ------------------------------------------
# App URLs
# ------------------------------------------
NEXT_PUBLIC_BASE_URL=http://localhost:3000                    # [REQUIRED] Canonical app URL
NEXT_PUBLIC_APP_URL=http://localhost:3000                     # Used in notification templates

# ------------------------------------------
# AI Providers
# ------------------------------------------
OPENAI_API_KEY=sk-...                                        # [REQUIRED] GPT-4o analysis, descriptions, captions
REPLICATE_API_TOKEN=r8_...                                   # [REQUIRED] SAM masks, inpainting, upscaling
RUNWARE_API_KEY=                                             # Runware provider (optional alternative)
AUTOENHANCE_API_KEY=                                         # AutoEnhance provider (optional)
ELEVENLABS_API_KEY=                                          # [REQUIRED for voiceover] Video voiceover TTS
FAL_API_KEY=                                                 # Fal.ai image enhancement provider (optional)
QUICK_ENHANCE_URL=                                           # AutoEnhance quick-enhance endpoint URL (optional)

# ------------------------------------------
# Stripe Payments
# ------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...               # [REQUIRED]
STRIPE_SECRET_KEY=sk_test_...                                # [REQUIRED]
STRIPE_WEBHOOK_SECRET=whsec_...                              # [REQUIRED] Stripe webhook signing secret

# ------------------------------------------
# Email (Resend)
# ------------------------------------------
RESEND_API_KEY=re_...                                        # [REQUIRED] Transactional emails

# ------------------------------------------
# Cloudflare (Worker + R2)
# ------------------------------------------
CLOUDFLARE_ACCOUNT_ID=                                       # Worker deployment
CLOUDFLARE_API_TOKEN=                                        # Worker deployment
CLOUDFLARE_R2_BUCKET=snapr-images                            # R2 bucket name
CLOUDFLARE_R2_PUBLIC_URL=                                    # R2 public URL for CDN
WORKER_URL=http://127.0.0.1:8787                             # Cloudflare Worker endpoint

# ------------------------------------------
# Cloudinary CDN
# ------------------------------------------
CLOUDINARY_CLOUD_NAME=                                       # Image CDN
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------
# Remotion Video (AWS Lambda)
# ------------------------------------------
REMOTION_AWS_REGION=us-east-1
REMOTION_AWS_ACCESS_KEY_ID=
REMOTION_AWS_SECRET_ACCESS_KEY=
REMOTION_LAMBDA_FUNCTION_NAME=                               # e.g. remotion-render-4-0-424-mem3008mb-disk2048mb-900sec
REMOTION_LAMBDA_SERVE_URL=                                   # Deployed site URL
REMOTION_S3_BUCKET_NAME=                                     # e.g. remotionlambda-useast1-xxxxx

# ------------------------------------------
# Social Media OAuth
# ------------------------------------------
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
NEXT_PUBLIC_FACEBOOK_APP_ID=                                 # Client-side FB SDK

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
NEXT_PUBLIC_LINKEDIN_CLIENT_ID=                              # Client-side OAuth redirect

TIKTOK_CLIENT_KEY=                                           # TikTok uses client_key, not client_id
TIKTOK_CLIENT_SECRET=

TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# ------------------------------------------
# WhatsApp (Twilio)
# ------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886                   # Twilio sandbox number

# ------------------------------------------
# Cron & Admin Auth
# ------------------------------------------
CRON_SECRET=                                                 # [REQUIRED] Bearer token for Vercel Cron jobs
WORKER_ADMIN_KEY=                                            # Admin key for internal API calls
ADMIN_SECRET=                                                # Admin routes auth

# ------------------------------------------
# Rate Limiting (Upstash Redis)
# ------------------------------------------
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# ------------------------------------------
# Monitoring
# ------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=                                      # Sentry error tracking
NEXT_PUBLIC_GOOGLE_MAPS_KEY=                                 # Google Maps embed on property pages
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/rajesh-snap-r/30min  # Calendly booking link

# ------------------------------------------
# AI Pipeline Tuning (all optional)
# ------------------------------------------
# ANALYSIS_PROVIDER=openai                                   # openai or replicate
# ANALYSIS_REPLICATE_MODEL=yorickvp/llava-13b
# ANALYSIS_CONCURRENCY=3
# ANALYSIS_BATCH_DELAY_MS=1000
# AI_ANALYSIS_FAIL_OPEN=false
# AI_SAM_MODEL=schananas/grounded_sam:...
# AI_INPAINT_PROVIDER=
# AI_KONTEXT_MODEL=black-forest-labs/flux-kontext-pro
# AI_BASE_ENHANCE=true
# AI_HERO_UPSCALE=true
# AI_QUALITY_GATE=false
# BATCH_MAX_CONCURRENCY=4
# BATCH_DELAY_MS=350
# REPLICATE_MIN_INTERVAL_MS=2000

# ------------------------------------------
# Floor Plans (optional)
# ------------------------------------------
# CUBICASA_API_KEY=
# IMAGEN_API_KEY=
