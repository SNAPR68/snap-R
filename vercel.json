{
  "functions": {
    "app/api/upload/route.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "app/api/listing/prepare/route.ts": {
      "maxDuration": 300,
      "memory": 1024
    },
    "app/api/enhance/route.ts": {
      "maxDuration": 180,
      "memory": 1024
    },
    "app/api/cron/publish-scheduled/route.ts": {
      "maxDuration": 300,
      "memory": 1024
    },
    "app/api/cron/sync-analytics/route.ts": {
      "maxDuration": 300,
      "memory": 1024
    },
    "app/api/cron/refresh-tokens/route.ts": {
      "maxDuration": 300,
      "memory": 1024
    },
    "app/api/video/generate/route.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "app/api/video/status/route.ts": {
      "maxDuration": 30,
      "memory": 512
    },
    "app/api/video/voiceover/route.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "app/api/marketing/print-materials/route.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "app/api/cron/daily-digest/route.ts": {
      "maxDuration": 300,
      "memory": 1024
    },
    "app/api/cron/drip-sequences/route.ts": {
      "maxDuration": 300,
      "memory": 1024
    },
    "app/api/cron/usage-check/route.ts": {
      "maxDuration": 300,
      "memory": 1024
    },
    "app/api/cron/mls-sync/route.ts": {
      "maxDuration": 300,
      "memory": 1024
    },
    "app/api/v1/photos/[id]/enhance/route.ts": {
      "maxDuration": 180,
      "memory": 1024
    },
    "app/api/v1/video/generate/route.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "app/api/v1/listings/[id]/prepare/route.ts": {
      "maxDuration": 300,
      "memory": 1024
    },
    "app/api/cron/verify-domains/route.ts": {
      "maxDuration": 300,
      "memory": 1024
    },
    "app/api/cron/cleanup/route.ts": {
      "maxDuration": 300,
      "memory": 1024
    },
    "app/api/cron/health-check/route.ts": {
      "maxDuration": 30,
      "memory": 512
    }
  },
  "headers": [
    {
      "source": "/p/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, s-maxage=3600, stale-while-revalidate=86400" },
        { "key": "CDN-Cache-Control", "value": "public, s-maxage=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/api/upload",
      "headers": [
        { "key": "x-vercel-proxy-body-size", "value": "52428800" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/publish-scheduled",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/sync-analytics",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/refresh-tokens",
      "schedule": "0 */4 * * *"
    },
    {
      "path": "/api/cron/daily-digest",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/drip-sequences",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/usage-check",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/health-check",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/mls-sync",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/verify-domains",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/cleanup",
      "schedule": "0 3 * * 0"
    }
  ]
}
