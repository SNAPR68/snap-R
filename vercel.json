{
  "functions": {
    "app/api/upload/route.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "app/api/listing/prepare/route.ts": {
      "maxDuration": 300,
      "memory": 1024
    },
    "app/api/enhance/route.ts": {
      "maxDuration": 180,
      "memory": 1024
    },
    "app/api/cron/publish-scheduled/route.ts": {
      "maxDuration": 300,
      "memory": 1024
    },
    "app/api/cron/sync-analytics/route.ts": {
      "maxDuration": 300,
      "memory": 1024
    },
    "app/api/cron/refresh-tokens/route.ts": {
      "maxDuration": 300,
      "memory": 1024
    },
    "app/api/video/generate/route.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "app/api/video/status/route.ts": {
      "maxDuration": 30,
      "memory": 512
    },
    "app/api/video/voiceover/route.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "app/api/marketing/print-materials/route.ts": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "headers": [
    {
      "source": "/p/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, must-revalidate" },
        { "key": "CDN-Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/api/upload",
      "headers": [
        { "key": "x-vercel-proxy-body-size", "value": "52428800" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/publish-scheduled",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/sync-analytics",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/refresh-tokens",
      "schedule": "0 */4 * * *"
    }
  ]
}
